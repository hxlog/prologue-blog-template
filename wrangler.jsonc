{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prologue-blog",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
